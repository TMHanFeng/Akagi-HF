+    pub fn extra_for<R: Rng + ?Sized>(&self, kind: DecisionKind, rng: &mut R) -> u32 {
+        if !self.enabled {
+            return 0;
+        }
+        if self.exclude_chi_pon && matches!(kind, DecisionKind::Chi | DecisionKind::Pon) {
+            return 0;
+        }
+        let lo = self.min_ms;
+        let hi = self.max_ms.max(lo);
+        if hi == lo {
+            lo
+        } else {
+            rng.random_range(lo..=hi)
+        }
     }
 }
 
